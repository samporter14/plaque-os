# Generate real local secrets with: python setup_local.py
DEVICE_ID=my-reader
DEVICE_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_URLSAFE_SECRET
SENDER_SECRET=REPLACE_WITH_ANOTHER_RANDOM_32_BYTE_URLSAFE_SECRET
SESSION_SECRET=REPLACE_WITH_A_THIRD_RANDOM_32_BYTE_URLSAFE_SECRET
# Local demo only. Set to 0 behind your HTTPS reverse proxy.
ALLOW_LOCAL_HTTP=1
# Require SESSION_COOKIE_SECURE and HTTPS when ALLOW_LOCAL_HTTP=0.
PUBLIC_ORIGIN=http://localhost:8787
MAILBOX_DB=.data/mailbox.sqlite3
